    {
      "name": "04 - Disponibilidades",
      "item": [
        {"name": "Listar Disponiveis", "request": {"method": "GET", "url": "{{baseUrl}}/veterinarian-availabilities/available?veterinarianId={{veterinarianId}}&start={{futureDateTime}}&end={{futureEndDateTime}}&page=0&size=20"}},
        {"name": "Listar por Veterinario", "request": {"method": "GET", "url": "{{baseUrl}}/veterinarian-availabilities/veterinarian/{{veterinarianId}}?start={{futureDateTime}}&end={{futureEndDateTime}}&page=0&size=20"}},
        {
          "name": "Criar Disponibilidade",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
