    {
      "name": "06 - Prontuarios",
      "item": [
        {
          "name": "Criar Prontuario",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('criou prontuario', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('medicalRecordId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"registrationDate\": \"{{pastDateTime}}\",\n  \"mainComplaint\": \"Consulta de rotina\",\n  \"diagnosis\": \"Animal sem alteracoes relevantes\",\n  \"conduct\": \"Acompanhamento preventivo\",\n  \"observations\": \"Sem observacoes adicionais\",\n  \"clinicalNotes\": \"Exame clinico realizado\",\n  \"recommendations\": \"Retorno conforme orientacao veterinaria\",\n  \"prescriptionNotes\": \"Sem prescricao\",\n  \"appointmentId\": null,\n  \"petId\": {{petId}},\n  \"veterinarianId\": {{veterinarianId}}\n}"},
            "url": "{{baseUrl}}/medical-records"
          }
        },
        {"name": "Buscar Prontuario por ID", "request": {"method": "GET", "url": "{{baseUrl}}/medical-records/{{medicalRecordId}}"}},
        {"name": "Listar Prontuarios por Pet", "request": {"method": "GET", "url": "{{baseUrl}}/medical-records/pet/{{petId}}?page=0&size=10"}},
        {"name": "Buscar Prontuarios por Data", "request": {"method": "GET", "url": "{{baseUrl}}/medical-records/search?start={{pastDateTime}}&end={{futureEndDateTime}}&page=0&size=10"}},
        {
          "name": "Atualizar Prontuario",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"registrationDate\": \"{{pastDateTime}}\",\n  \"mainComplaint\": \"Consulta de rotina atualizada\",\n  \"diagnosis\": \"Sem alteracoes relevantes\",\n  \"conduct\": \"Acompanhamento preventivo\",\n  \"observations\": \"Sem observacoes adicionais\",\n  \"clinicalNotes\": \"Exame clinico realizado\",\n  \"recommendations\": \"Retorno conforme orientacao veterinaria\",\n  \"prescriptionNotes\": \"Sem prescricao\",\n  \"appointmentId\": null,\n  \"petId\": {{petId}},\n  \"veterinarianId\": {{veterinarianId}}\n}"},
            "url": "{{baseUrl}}/medical-records/{{medicalRecordId}}"
          }
        },
        {"name": "Excluir Prontuario", "request": {"method": "DELETE", "url": "{{baseUrl}}/medical-records/{{medicalRecordId}}"}}
      ]
    },
    {
      "name": "07 - Medicamentos",
      "item": [
        {
          "name": "Criar Medicamento",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('criou medicamento', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('medicationId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Medicamento Postman\",\n  \"dosage\": \"1 comprimido\",\n  \"frequency\": \"12/12h\",\n  \"startDate\": \"2026-01-10\",\n  \"endDate\": \"2026-01-20\",\n  \"observations\": \"Administrar apos alimentacao\",\n  \"status\": \"ATIVO\",\n  \"petId\": {{petId}},\n  \"veterinarianId\": {{veterinarianId}}\n}"},
            "url": "{{baseUrl}}/medications"
          }
        },
        {"name": "Buscar Medicamento por ID", "request": {"method": "GET", "url": "{{baseUrl}}/medications/{{medicationId}}"}},
        {"name": "Listar Medicamentos por Pet", "request": {"method": "GET", "url": "{{baseUrl}}/medications/pet/{{petId}}?page=0&size=10"}},
        {
          "name": "Atualizar Medicamento",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Medicamento Postman Atualizado\",\n  \"dosage\": \"2 comprimidos\",\n  \"frequency\": \"24/24h\",\n  \"startDate\": \"2026-01-10\",\n  \"endDate\": \"2026-01-20\",\n  \"observations\": \"Administrar apos alimentacao\",\n  \"status\": \"ATIVO\",\n  \"petId\": {{petId}},\n  \"veterinarianId\": {{veterinarianId}}\n}"},
            "url": "{{baseUrl}}/medications/{{medicationId}}"
          }
        },
        {"name": "Excluir Medicamento", "request": {"method": "DELETE", "url": "{{baseUrl}}/medications/{{medicationId}}"}}
      ]
    },
    {
      "name": "08 - Workflows",
      "item": [
        {
          "name": "Cadastrar Tutor com Pet e Primeiro Acesso",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('workflow tutor pet 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('tutorId', json.tutor.id);",
            "pm.collectionVariables.set('petId', json.pet.id);",
            "pm.collectionVariables.set('firstAccessCode', json.firstAccessCode || '');"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tutor\": {\n    \"name\": \"Tutor Workflow {{runId}}\",\n    \"cpf\": \"{{workflowTutorCpf}}\",\n    \"phone\": \"11999999999\",\n    \"email\": \"{{workflowTutorEmail}}\"\n  },\n  \"pet\": {\n    \"name\": \"Pet Workflow {{runId}}\",\n    \"species\": \"CACHORRO\",\n    \"breed\": \"SRD\",\n    \"sex\": \"MACHO\",\n    \"birthDate\": \"2021-04-10\",\n    \"weight\": 14.7,\n    \"tutorId\": 1\n  }\n}"},
            "url": "{{baseUrl}}/workflows/tutors/register-with-pet"
          }
        },
        {
          "name": "Registrar Consulta Completa",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "if (pm.response.code === 201) {",
            "  const json = pm.response.json();",
            "  if (json.medicalRecord && json.medicalRecord.id) pm.collectionVariables.set('medicalRecordId', json.medicalRecord.id);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"appointmentId\": {{appointmentId}},\n  \"mainComplaint\": \"Consulta de rotina\",\n  \"diagnosis\": \"Animal sem alteracoes relevantes\",\n  \"conduct\": \"Acompanhamento preventivo\",\n  \"observations\": \"Sem observacoes adicionais\",\n  \"clinicalNotes\": \"Exame clinico realizado\",\n  \"recommendations\": \"Retorno conforme orientacao veterinaria\",\n  \"prescriptionNotes\": \"Sem prescricao\",\n  \"medications\": [\n    {\n      \"name\": \"Medicamento Workflow\",\n      \"dosage\": \"1 comprimido\",\n      \"frequency\": \"12/12h\",\n      \"startDate\": \"2026-01-10\",\n      \"endDate\": \"2026-01-20\",\n      \"observations\": \"Administrar apos alimentacao\"\n    }\n  ]\n}"},
            "url": "{{baseUrl}}/workflows/consultations/register"
          }
        }
      ]
    }
  ]
