{
  "info": {
    "_postman_id": "5d2e1f52-8a9d-4dd2-9f86-2e6f7e8a9b10",
    "name": "PetJourney API - Entrega",
    "description": "Collection completa para testar a API PetJourney. A variavel baseUrl aponta para o Railway de producao; altere para http://localhost:8080 para teste local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const resetRequests = ['Login ADMIN_CLINICA'];",
          "if (resetRequests.includes(pm.info.requestName) || !pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString().slice(-8) + Math.floor(Math.random() * 100).toString().padStart(2, '0');",
          "  const cpfBase = Math.floor(10000000000 + Math.random() * 89999999999).toString();",
          "  const workflowCpfBase = Math.floor(10000000000 + Math.random() * 89999999999).toString();",
          "  const testRecipient = (pm.collectionVariables.get('testEmailRecipient') || '').trim();",
          "  const canUseRealInbox = testRecipient && testRecipient.includes('@') && !testRecipient.includes('seuemail');",
          "  const emailFor = (prefix) => {",
          "    if (!canUseRealInbox) return `${prefix}.${runId}@exemplo.com`;",
          "    const [local, domain] = testRecipient.split('@');",
          "    return `${local}+${prefix}.${runId}@${domain}`;",
          "  };",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('stamp', runId);",
          "  pm.collectionVariables.set('tutorCpf', cpfBase);",
          "  pm.collectionVariables.set('workflowTutorCpf', workflowCpfBase);",
          "  pm.collectionVariables.set('tutorEmail', emailFor('tutor'));",
          "  pm.collectionVariables.set('workflowTutorEmail', emailFor('tutor.workflow'));",
          "  pm.collectionVariables.set('vetEmail', emailFor('vet'));",
          "  pm.collectionVariables.set('clinicEmail', emailFor('clinica'));",
          "  pm.collectionVariables.set('adminClinicEmail', emailFor('admin.clinica'));",
          "}",
          "pm.collectionVariables.set('futureDateTime', new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString().slice(0, 19));",
          "pm.collectionVariables.set('futureEndDateTime', new Date(Date.now() + 3 * 24 * 60 * 60 * 1000 + 60 * 60 * 1000).toISOString().slice(0, 19));",
          "pm.collectionVariables.set('pastDateTime', new Date(Date.now() - 60 * 60 * 1000).toISOString().slice(0, 19));"
        ]
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "https://api-java-petjourney-production.up.railway.app", "type": "string"},
    {"key": "testEmailRecipient", "value": "seuemail@gmail.com", "type": "string"},
    {"key": "token", "value": "", "type": "string"},
    {"key": "adminSistemaToken", "value": "", "type": "string"},
    {"key": "adminClinicaToken", "value": "", "type": "string"},
    {"key": "veterinarioToken", "value": "", "type": "string"},
    {"key": "tutorToken", "value": "", "type": "string"},
    {"key": "clinicId", "value": "1", "type": "string"},
    {"key": "createdClinicId", "value": "", "type": "string"},
    {"key": "tutorId", "value": "1", "type": "string"},
    {"key": "petId", "value": "1", "type": "string"},
    {"key": "veterinarianId", "value": "1", "type": "string"},
    {"key": "appointmentId", "value": "1", "type": "string"},
    {"key": "medicalRecordId", "value": "1", "type": "string"},
    {"key": "medicationId", "value": "1", "type": "string"},
    {"key": "availabilityId", "value": "1", "type": "string"},
    {"key": "firstAccessCode", "value": "", "type": "string"},
    {"key": "runId", "value": "", "type": "string"},
    {"key": "stamp", "value": "", "type": "string"},
    {"key": "tutorCpf", "value": "", "type": "string"},
    {"key": "workflowTutorCpf", "value": "", "type": "string"},
    {"key": "tutorEmail", "value": "", "type": "string"},
    {"key": "workflowTutorEmail", "value": "", "type": "string"},
    {"key": "vetEmail", "value": "", "type": "string"},
    {"key": "clinicEmail", "value": "", "type": "string"},
    {"key": "adminClinicEmail", "value": "", "type": "string"},
    {"key": "futureDateTime", "value": "", "type": "string"},
    {"key": "futureEndDateTime", "value": "", "type": "string"},
    {"key": "pastDateTime", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login ADMIN_CLINICA",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('login admin clinica 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.token);",
            "pm.collectionVariables.set('adminClinicaToken', json.token);",
            "pm.collectionVariables.set('clinicId', json.clinicId || '1');"
          ]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"admin.petfeliz@petjourney.com\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login ADMIN_SISTEMA",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('login admin sistema 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('adminSistemaToken', json.token);"
          ]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"admin.sistema@petjourney.com\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login VETERINARIO Seed",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('login veterinario 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('veterinarioToken', json.token);",
            "pm.collectionVariables.set('veterinarianId', json.veterinarianId || pm.collectionVariables.get('veterinarianId'));"
          ]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"joao@petjourney.com\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login TUTOR Seed",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('login tutor 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('tutorToken', json.token);",
            "pm.collectionVariables.set('tutorId', json.tutorId || pm.collectionVariables.get('tutorId'));"
          ]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"carlos@petjourney.com\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Usuario Atual",
          "request": {"method": "GET", "url": "{{baseUrl}}/auth/me"}
        },
        {
          "name": "Ativar Primeiro Acesso",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"email_destino@exemplo.com\",\n  \"code\": \"{{firstAccessCode}}\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/first-access/activate"
          }
        }
      ]
    },
    {
      "name": "01 - Sistema e Clinicas",
      "item": [
        {"name": "Listar Clinicas", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{adminSistemaToken}}", "type": "string"}]}, "method": "GET", "url": "{{baseUrl}}/clinics?page=0&size=10"}},
        {"name": "Buscar Clinica por ID", "request": {"method": "GET", "url": "{{baseUrl}}/clinics/{{clinicId}}"}},
        {
          "name": "Criar Clinica - ADMIN_SISTEMA",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('createdClinicId', pm.response.json().id);"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{adminSistemaToken}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Clinica Postman {{runId}}\",\n  \"cnpj\": \"11222333000181\",\n  \"phone\": \"1133334444\",\n  \"email\": \"{{clinicEmail}}\",\n  \"address\": \"Rua Teste, 100\"\n}"},
            "url": "{{baseUrl}}/clinics"
          }
        },
        {
          "name": "Atualizar Clinica Criada",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{adminSistemaToken}}", "type": "string"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Clinica Postman Atualizada\",\n  \"cnpj\": \"11222333000181\",\n  \"phone\": \"1133335555\",\n  \"email\": \"clinica.atualizada@exemplo.com\",\n  \"address\": \"Rua Atualizada, 200\"\n}"},
            "url": "{{baseUrl}}/clinics/{{createdClinicId}}"
          }
        },
        {
          "name": "Criar Admin da Clinica",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{adminSistemaToken}}", "type": "string"}]},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{adminClinicEmail}}\",\n  \"password\": \"123456\"\n}"},
            "url": "{{baseUrl}}/system/clinics/{{clinicId}}/admins"
          }
        },
        {"name": "Excluir Clinica Criada - Soft Delete", "request": {"auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{adminSistemaToken}}", "type": "string"}]}, "method": "DELETE", "url": "{{baseUrl}}/clinics/{{createdClinicId}}"}}
      ]
    },
    {
      "name": "02 - Tutores e Pets",
      "item": [
