            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Consulta Workflow Postman\",\n  \"description\": \"Agendamento pelo workflow\",\n  \"petId\": {{petId}},\n  \"clinicId\": {{clinicId}},\n  \"veterinarianId\": {{veterinarianId}},\n  \"dateTime\": \"{{futureDateTime}}\"\n}"},
            "url": "{{baseUrl}}/workflows/appointments/schedule"
          }
        },
        {"name": "Buscar Agendamento por ID", "request": {"method": "GET", "url": "{{baseUrl}}/appointments/{{appointmentId}}"}},
        {"name": "Listar Agendamentos por Pet", "request": {"method": "GET", "url": "{{baseUrl}}/appointments/pet/{{petId}}?page=0&size=10"}},
        {"name": "Buscar Agendamentos por Data", "request": {"method": "GET", "url": "{{baseUrl}}/appointments/search?start={{pastDateTime}}&end={{futureEndDateTime}}&page=0&size=10"}},
        {
          "name": "Atualizar Agendamento",
          "request": {
